# Django Settings
SECRET_KEY=replace-with-a-unique-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database (PostgreSQL for Prod, SQLite fallback for Dev if DATABASE_URL is empty)
DATABASE_URL=postgres://meeting_user:meeting_pass@localhost:5432/meeting_portal_db

# Firebase Credentials (For verification in production. In dev/demo mode, fallback allows Google demo login)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@appspot.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"

# GenAI API Keys (Gemini API or OpenAI API)
LLM_PROVIDER=gemini  # gemini or openai or mock
LLM_API_KEY=your-gemini-or-openai-api-key
GEMINI_MODEL=gemini-2.5-flash

# Email Settings (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@company.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL="Company Meeting Portal <notifications@company.com>"
